# Team notify file. Do not commit a real webhook.
# Admin copies this to one machine-wide path, then engineers only run:
#   pip install sentinal-trace && sentinal-trace install
#
# Windows:  %PROGRAMDATA%\sentinal-trace\notify.env
# macOS:    /Library/Application Support/sentinal-trace/notify.env
# Linux:    /etc/sentinal-trace/notify.env
#
# Slack/Teams/Discord incoming webhook is the team path (not per-user Gmail).
SENTINAL_TRACE_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
